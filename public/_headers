# Headers for static assets (Cloudflare Workers). Responses from worker/index.ts
# (the R2 videos) set their own. Every matching block applies.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000

# Content-hashed by Next: never changes under the same URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The site only links these with ?v=<content hash> (scripts/media-manifest.mjs).
/media/*
  Cache-Control: public, max-age=31536000, immutable
/work/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/krishna-sharma.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The client router's prefetch payloads are for the app, not for search results.
/*.txt
  X-Robots-Tag: noindex
