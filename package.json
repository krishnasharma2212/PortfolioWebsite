{
  "name": "v3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/media-manifest.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/media-manifest.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "npx serve@14 out",
    "lint": "eslint",
    "preview": "npm run build && node scripts/upload-media.mjs --local && wrangler dev",
    "media:upload": "node scripts/upload-media.mjs",
    "deploy": "npm run build && node scripts/upload-media.mjs && wrangler deploy && wrangler deploy -c wrangler.apex.jsonc && node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
